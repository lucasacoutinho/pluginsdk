{"name": "empty", "request": {"schema": 1, "type": "quote_windows_argument", "input": {"text": ""}}, "expected": {"schema": 1, "type": "quote_windows_argument", "output": {"quoted": "\"\""}}}
{"name": "plain", "request": {"schema": 1, "type": "quote_windows_argument", "input": {"text": "alpha"}}, "expected": {"schema": 1, "type": "quote_windows_argument", "output": {"quoted": "\"alpha\""}}}
{"name": "spaces", "request": {"schema": 1, "type": "quote_windows_argument", "input": {"text": "two words"}}, "expected": {"schema": 1, "type": "quote_windows_argument", "output": {"quoted": "\"two words\""}}}
{"name": "tabs", "request": {"schema": 1, "type": "quote_windows_argument", "input": {"text": "a\tb"}}, "expected": {"schema": 1, "type": "quote_windows_argument", "output": {"quoted": "\"a\tb\""}}}
{"name": "quote", "request": {"schema": 1, "type": "quote_windows_argument", "input": {"text": "a\"b"}}, "expected": {"schema": 1, "type": "quote_windows_argument", "output": {"quoted": "\"a\\\"b\""}}}
{"name": "two_quotes", "request": {"schema": 1, "type": "quote_windows_argument", "input": {"text": "\"\""}}, "expected": {"schema": 1, "type": "quote_windows_argument", "output": {"quoted": "\"\\\"\\\"\""}}}
{"name": "backslash_quote", "request": {"schema": 1, "type": "quote_windows_argument", "input": {"text": "a\\\"b"}}, "expected": {"schema": 1, "type": "quote_windows_argument", "output": {"quoted": "\"a\\\\\\\"b\""}}}
{"name": "two_backslashes_quote", "request": {"schema": 1, "type": "quote_windows_argument", "input": {"text": "a\\\\\"b"}}, "expected": {"schema": 1, "type": "quote_windows_argument", "output": {"quoted": "\"a\\\\\\\\\\\"b\""}}}
{"name": "trailing_backslash", "request": {"schema": 1, "type": "quote_windows_argument", "input": {"text": "path\\"}}, "expected": {"schema": 1, "type": "quote_windows_argument", "output": {"quoted": "\"path\\\\\""}}}
{"name": "two_trailing_backslashes", "request": {"schema": 1, "type": "quote_windows_argument", "input": {"text": "path\\\\"}}, "expected": {"schema": 1, "type": "quote_windows_argument", "output": {"quoted": "\"path\\\\\\\\\""}}}
{"name": "backslash_only", "request": {"schema": 1, "type": "quote_windows_argument", "input": {"text": "\\"}}, "expected": {"schema": 1, "type": "quote_windows_argument", "output": {"quoted": "\"\\\\\""}}}
{"name": "interior_backslashes", "request": {"schema": 1, "type": "quote_windows_argument", "input": {"text": "C:\\tools\\plugin\\file.json"}}, "expected": {"schema": 1, "type": "quote_windows_argument", "output": {"quoted": "\"C:\\tools\\plugin\\file.json\""}}}
{"name": "path_with_spaces", "request": {"schema": 1, "type": "quote_windows_argument", "input": {"text": "C:\\Program Files\\Node\\node.exe"}}, "expected": {"schema": 1, "type": "quote_windows_argument", "output": {"quoted": "\"C:\\Program Files\\Node\\node.exe\""}}}
{"name": "unicode", "request": {"schema": 1, "type": "quote_windows_argument", "input": {"text": "Olá 👋 日本語"}}, "expected": {"schema": 1, "type": "quote_windows_argument", "output": {"quoted": "\"Olá 👋 日本語\""}}}
{"name": "line_breaks", "request": {"schema": 1, "type": "quote_windows_argument", "input": {"text": "one\r\ntwo"}}, "expected": {"schema": 1, "type": "quote_windows_argument", "output": {"quoted": "\"one\r\ntwo\""}}}
{"name": "shell_characters", "request": {"schema": 1, "type": "quote_windows_argument", "input": {"text": "& | < > ^ %PATH% !USER! $(x); `echo x`"}}, "expected": {"schema": 1, "type": "quote_windows_argument", "output": {"quoted": "\"& | < > ^ %PATH% !USER! $(x); `echo x`\""}}}
{"name": "quote_then_trailing_backslash", "request": {"schema": 1, "type": "quote_windows_argument", "input": {"text": "\"\\"}}, "expected": {"schema": 1, "type": "quote_windows_argument", "output": {"quoted": "\"\\\"\\\\\""}}}
